{
  "name": "@thumble/mobile",
  "private": true,
  "version": "0.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "node --dns-result-order=ipv4first ./node_modules/expo/bin/cli start --localhost --port 8087",
    "prebuild": "expo prebuild --no-install",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "export": "expo export --platform all --output-dir dist"
  },
  "dependencies": {
    "@thumble/client": "workspace:*",
    "@thumble/contracts": "workspace:*",
    "@thumble/domain": "workspace:*",
    "expo": "58.0.17",
    "expo-build-properties": "58.0.11",
    "expo-modules-core": "58.0.24",
    "expo-router": "58.0.25",
    "expo-status-bar": "58.0.4",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.0",
    "react-dom": "19.3.0",
    "expo-system-ui": "58.0.6",
    "react-native-gesture-handler": "3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-test-renderer": "19.3.0",
    "react-test-renderer": "19.3.0"
  },
  "expo": {
    "autolinking": {
      "nativeModulesDir": "./modules"
    }
  }
}

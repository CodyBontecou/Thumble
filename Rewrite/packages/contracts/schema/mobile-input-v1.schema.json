{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Thumble native control map v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "generation",
    "revision",
    "controls"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "generation": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,19}$"
    },
    "revision": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "controls": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "action",
          "x",
          "y",
          "width",
          "height"
        ],
        "properties": {
          "hapticFeedback": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "style",
              "pattern",
              "intensity",
              "sharpness",
              "duration"
            ],
            "properties": {
              "style": {
                "enum": [
                  "none",
                  "light",
                  "medium",
                  "heavy",
                  "soft",
                  "rigid"
                ]
              },
              "pattern": {
                "enum": [
                  "single",
                  "double",
                  "pulse",
                  "buzz"
                ]
              },
              "intensity": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "sharpness": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "duration": {
                "type": "number",
                "minimum": 0.02,
                "maximum": 0.3
              }
            }
          },
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9-]{1,64}$"
          },
          "action": {
            "enum": [
              "south",
              "east",
              "west",
              "north",
              "leftShoulder",
              "rightShoulder",
              "leftTriggerButton",
              "rightTriggerButton",
              "select",
              "start",
              "home",
              "leftStickPress",
              "rightStickPress",
              "dpadUp",
              "dpadDown",
              "dpadLeft",
              "dpadRight",
              "leftStick",
              "rightStick",
              "leftTrigger",
              "rightTrigger",
              "leftStandardStick",
              "rightStandardStick",
              "leftVerticalTrigger",
              "rightVerticalTrigger",
              "leftHorizontalTrigger",
              "rightHorizontalTrigger"
            ]
          },
          "x": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "y": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "width": {
            "type": "number",
            "minimum": 0.001,
            "maximum": 1
          },
          "height": {
            "type": "number",
            "minimum": 0.001,
            "maximum": 1
          }
        }
      }
    }
  },
  "$comment": "Native and TypeScript validators additionally check u64 bounds, unique IDs, and rectangle sums within the unit viewport. Coordinates are normalized in the native surface bounds, independent of screen density."
}

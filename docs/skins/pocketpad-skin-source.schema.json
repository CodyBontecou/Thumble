{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pocketpad.app/schemas/pocketpad-skin-source.schema.json",
  "title": "Thumble editable handcrafted skin source",
  "type": "object",
  "required": [
    "schema",
    "schemaVersion",
    "identifier",
    "version",
    "name",
    "author",
    "summary",
    "license",
    "artboardID",
    "orientations",
    "colorSchemes",
    "palette",
    "materials",
    "components",
    "assignments",
    "sourceAssets",
    "previews"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "enum": [
              1,
              2
            ]
          }
        },
        "required": [
          "schemaVersion"
        ]
      },
      "then": {
        "properties": {
          "capturedArtboards": {
            "maxItems": 0
          },
          "controlSemantics": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": 1
          }
        },
        "required": [
          "schemaVersion"
        ]
      },
      "then": {
        "properties": {
          "stylesheets": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stylesheets": {
            "minItems": 1
          }
        },
        "required": [
          "stylesheets"
        ]
      },
      "then": {
        "properties": {
          "materials": {
            "minItems": 0
          },
          "components": {
            "minItems": 0
          },
          "assignments": {
            "minItems": 0
          },
          "sourceAssets": {
            "minItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "controlSemantics": {
            "minItems": 1
          }
        },
        "required": [
          "controlSemantics"
        ]
      },
      "then": {
        "properties": {
          "schemaVersion": {
            "const": 3
          },
          "stylesheets": {
            "minItems": 1
          }
        },
        "required": [
          "stylesheets"
        ]
      }
    }
  ],
  "properties": {
    "controlSemantics": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/controlSemantics"
      }
    },
    "schema": {
      "const": "com.codybontecou.pocketpad.skin-source"
    },
    "schemaVersion": {
      "enum": [
        1,
        2,
        3
      ]
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*(\\.[A-Za-z][A-Za-z0-9_-]*){2,}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "author": {
      "$ref": "#/$defs/author"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "artboardID": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "orientations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/orientation"
      }
    },
    "colorSchemes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/colorScheme"
      }
    },
    "palette": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/palette"
      }
    },
    "materials": {
      "type": "array",
      "minItems": 3,
      "items": {
        "$ref": "#/$defs/material"
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/component"
      }
    },
    "assignments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/assignment"
      }
    },
    "sourceAssets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/sourceAsset"
      }
    },
    "stylesheets": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^styles/(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.css$"
      }
    },
    "capturedArtboards": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "$ref": "#/$defs/capturedArtboard"
      }
    },
    "previews": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/preview"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "controlSemantics": {
      "type": "object",
      "required": [
        "controlID",
        "groups"
      ],
      "properties": {
        "controlID": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "action": {
          "type": "string",
          "pattern": "^[a-z0-9._-]{1,64}$"
        },
        "purpose": {
          "type": "string",
          "pattern": "^[a-z0-9._-]{1,64}$"
        },
        "groups": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9._-]{1,64}$"
          }
        }
      },
      "additionalProperties": false
    },
    "capturedArtboard": {
      "type": "object",
      "required": [
        "id",
        "revision",
        "templateID",
        "name",
        "summary",
        "variants",
        "expectedRoles"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "templateID": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "variants": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "type": "object",
            "required": [
              "id",
              "orientation",
              "canvasWidth",
              "canvasHeight",
              "safeAreaInsets",
              "controls"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "orientation": {
                "$ref": "#/$defs/orientation"
              },
              "canvasWidth": {
                "type": "number",
                "minimum": 240,
                "maximum": 1800
              },
              "canvasHeight": {
                "type": "number",
                "minimum": 240,
                "maximum": 1800
              },
              "safeAreaInsets": {
                "type": "object",
                "required": [
                  "top",
                  "leading",
                  "bottom",
                  "trailing"
                ],
                "properties": {
                  "top": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 0.45
                  },
                  "leading": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 0.45
                  },
                  "bottom": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 0.45
                  },
                  "trailing": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 0.45
                  }
                },
                "additionalProperties": false
              },
              "controls": {
                "type": "array",
                "maxItems": 256,
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "label",
                    "kind",
                    "visualRole",
                    "frame"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "label": {
                      "type": "string"
                    },
                    "kind": {
                      "enum": [
                        "button",
                        "joystick",
                        "trigger",
                        "trackpad",
                        "text",
                        "decoration"
                      ]
                    },
                    "visualRole": {
                      "$ref": "#/$defs/role"
                    },
                    "inputID": {
                      "$ref": "#/$defs/button"
                    },
                    "frame": {
                      "$ref": "#/$defs/rect"
                    },
                    "rotationDegrees": {
                      "type": "number",
                      "minimum": -180,
                      "maximum": 180
                    },
                    "presentation": {
                      "$ref": "#/$defs/nativePresentation"
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        },
        "expectedRoles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/role"
          }
        }
      },
      "additionalProperties": false
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "hex": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}(?:[0-9A-Fa-f]{2})?$"
    },
    "orientation": {
      "enum": [
        "portrait",
        "landscape"
      ]
    },
    "colorScheme": {
      "enum": [
        "light",
        "dark"
      ]
    },
    "role": {
      "enum": [
        "movement",
        "primary_action",
        "secondary_action",
        "utility",
        "menu",
        "custom",
        "joystick",
        "trigger",
        "trackpad",
        "decoration",
        "system"
      ]
    },
    "button": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$",
      "description": "Actual control UUID; named input slots are not supported."
    },
    "shape": {
      "enum": [
        "rounded_rectangle",
        "rectangle",
        "capsule",
        "circle",
        "ellipse",
        "polygon",
        "star"
      ]
    },
    "author": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      },
      "additionalProperties": false
    },
    "rect": {
      "type": "object",
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "insets": {
      "type": "object",
      "required": [
        "top",
        "leading",
        "bottom",
        "trailing"
      ],
      "properties": {
        "top": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.45
        },
        "leading": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.45
        },
        "bottom": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.45
        },
        "trailing": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.45
        }
      },
      "additionalProperties": false
    },
    "palette": {
      "type": "object",
      "required": [
        "id",
        "light"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "light": {
          "$ref": "#/$defs/hex"
        },
        "dark": {
          "$ref": "#/$defs/hex"
        }
      },
      "additionalProperties": false
    },
    "material": {
      "type": "object",
      "required": [
        "id",
        "name",
        "kind",
        "baseColor",
        "foregroundColor",
        "depth",
        "gloss",
        "pressedScale"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "kind": {
          "enum": [
            "translucent_plastic",
            "opaque_plastic",
            "matte_rubber",
            "glossy_plastic",
            "glass",
            "metal",
            "raised",
            "inset"
          ]
        },
        "baseColor": {
          "$ref": "#/$defs/hex"
        },
        "darkBaseColor": {
          "$ref": "#/$defs/hex"
        },
        "foregroundColor": {
          "$ref": "#/$defs/hex"
        },
        "darkForegroundColor": {
          "$ref": "#/$defs/hex"
        },
        "strokeColor": {
          "$ref": "#/$defs/hex"
        },
        "darkStrokeColor": {
          "$ref": "#/$defs/hex"
        },
        "highlightColor": {
          "$ref": "#/$defs/hex"
        },
        "activeColor": {
          "$ref": "#/$defs/hex"
        },
        "darkActiveColor": {
          "$ref": "#/$defs/hex"
        },
        "activeIndexColor": {
          "$ref": "#/$defs/hex"
        },
        "darkActiveIndexColor": {
          "$ref": "#/$defs/hex"
        },
        "activeIndexWidth": {
          "type": "number",
          "minimum": 0,
          "maximum": 12
        },
        "shadowColor": {
          "$ref": "#/$defs/hex"
        },
        "joystickKnobColor": {
          "$ref": "#/$defs/hex"
        },
        "darkJoystickKnobColor": {
          "$ref": "#/$defs/hex"
        },
        "pressedFillColor": {
          "$ref": "#/$defs/hex"
        },
        "darkPressedFillColor": {
          "$ref": "#/$defs/hex"
        },
        "activeFillColor": {
          "$ref": "#/$defs/hex"
        },
        "darkActiveFillColor": {
          "$ref": "#/$defs/hex"
        },
        "disabledFillColor": {
          "$ref": "#/$defs/hex"
        },
        "darkDisabledFillColor": {
          "$ref": "#/$defs/hex"
        },
        "disabledForegroundColor": {
          "$ref": "#/$defs/hex"
        },
        "darkDisabledForegroundColor": {
          "$ref": "#/$defs/hex"
        },
        "disabledStrokeColor": {
          "$ref": "#/$defs/hex"
        },
        "darkDisabledStrokeColor": {
          "$ref": "#/$defs/hex"
        },
        "shadowScale": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "pressedShadowScale": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "pressedInnerShadowScale": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "activeStrokeWidth": {
          "type": "number",
          "minimum": 0,
          "maximum": 12
        },
        "portraitActiveStrokeWidth": {
          "type": "number",
          "minimum": 0,
          "maximum": 12
        },
        "landscapeActiveStrokeWidth": {
          "type": "number",
          "minimum": 0,
          "maximum": 12
        },
        "disabledStrokeWidth": {
          "type": "number",
          "minimum": 0,
          "maximum": 12
        },
        "disabledOpacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "depth": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "gloss": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "cornerRadius": {
          "type": "number",
          "minimum": 0,
          "maximum": 128
        },
        "pressedScale": {
          "type": "number",
          "minimum": 0.8,
          "maximum": 1
        },
        "hapticFeedback": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "component": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "materialID",
        "zIndex"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "canvas_background",
            "controller_shell",
            "control_well",
            "button_face",
            "dpad",
            "joystick",
            "utility_button",
            "decorative_artwork"
          ]
        },
        "materialID": {
          "$ref": "#/$defs/id"
        },
        "role": {
          "$ref": "#/$defs/role"
        },
        "button": {
          "$ref": "#/$defs/button"
        },
        "frame": {
          "$ref": "#/$defs/rect"
        },
        "shape": {
          "$ref": "#/$defs/shape"
        },
        "zIndex": {
          "type": "integer",
          "minimum": -10000,
          "maximum": 10000
        },
        "sourceAssetID": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string",
          "maxLength": 100
        }
      },
      "additionalProperties": false
    },
    "assignment": {
      "type": "object",
      "required": [
        "materialID"
      ],
      "properties": {
        "role": {
          "$ref": "#/$defs/role"
        },
        "button": {
          "$ref": "#/$defs/button"
        },
        "materialID": {
          "$ref": "#/$defs/id"
        },
        "componentID": {
          "$ref": "#/$defs/id"
        }
      },
      "anyOf": [
        {
          "required": [
            "role"
          ]
        },
        {
          "required": [
            "button"
          ]
        }
      ],
      "additionalProperties": false
    },
    "sourceAsset": {
      "type": "object",
      "required": [
        "id",
        "path",
        "purpose",
        "outputWidth",
        "outputHeight",
        "format"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "path": {
          "type": "string",
          "pattern": "^sources/(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.svg$"
        },
        "purpose": {
          "enum": [
            "canvas_artwork",
            "control_face",
            "icon",
            "texture",
            "preview"
          ]
        },
        "outputWidth": {
          "type": "integer",
          "minimum": 16,
          "maximum": 8192
        },
        "outputHeight": {
          "type": "integer",
          "minimum": 16,
          "maximum": 8192
        },
        "format": {
          "enum": [
            "png",
            "webp"
          ]
        },
        "nineSliceInsets": {
          "$ref": "#/$defs/insets"
        },
        "orientation": {
          "$ref": "#/$defs/orientation"
        },
        "colorScheme": {
          "$ref": "#/$defs/colorScheme"
        },
        "anchor": {
          "$ref": "#/$defs/artworkAnchor"
        }
      },
      "additionalProperties": false
    },
    "preview": {
      "type": "object",
      "required": [
        "id",
        "artboardID",
        "orientation",
        "colorScheme",
        "state",
        "scale"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "artboardID": {
          "type": "string",
          "minLength": 1
        },
        "orientation": {
          "$ref": "#/$defs/orientation"
        },
        "colorScheme": {
          "$ref": "#/$defs/colorScheme"
        },
        "state": {
          "enum": [
            "normal",
            "pressed",
            "active",
            "disabled"
          ]
        },
        "scale": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 4
        }
      },
      "additionalProperties": false
    },
    "artworkAnchor": {
      "type": "object",
      "properties": {
        "controlID": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "action": {
          "type": "string",
          "pattern": "^[a-z0-9_.-]{1,64}$"
        },
        "group": {
          "type": "string",
          "pattern": "^[a-z0-9_.-]{1,64}$"
        },
        "scaleX": {
          "type": "number",
          "minimum": 0.25,
          "maximum": 4
        },
        "scaleY": {
          "type": "number",
          "minimum": 0.25,
          "maximum": 4
        },
        "offsetX": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "offsetY": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "plane": {
          "enum": [
            "underlay",
            "overlay"
          ]
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "zIndex": {
          "type": "integer",
          "minimum": -10000,
          "maximum": 10000
        }
      },
      "oneOf": [
        {
          "required": [
            "controlID"
          ]
        },
        {
          "required": [
            "action"
          ]
        },
        {
          "required": [
            "group"
          ]
        }
      ],
      "additionalProperties": false,
      "description": "CSS schema 3 canvas artwork anchored to 1...32 visible captured controls. Exactly one target. Scale/offset use the target union layout bounds; every resolved frame must stay in the canvas."
    },
    "nativePresentation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "enum": [
            1
          ],
          "default": 1
        },
        "actionID": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9._-]+$"
        },
        "purposeID": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9._-]+$"
        },
        "groupIDs": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "default": [],
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z0-9._-]+$"
          }
        },
        "legend": {
          "type": "string",
          "maxLength": 64
        },
        "caption": {
          "type": "string",
          "maxLength": 128
        },
        "accessibilityName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    }
  }
}

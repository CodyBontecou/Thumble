{
  "name": "thumble",
  "version": "0.1.0",
  "description": "Inspect saved Thumble phone controller layouts, registered devices, and delivery receipts with read-only OAuth access.",
  "mcpServers": {
    "thumble": {
      "httpUrl": "https://thumble.io/mcp",
      "includeTools": [
        "profile_schema",
        "list_profiles",
        "get_profile",
        "list_devices",
        "delivery_status"
      ],
      "oauth": {
        "enabled": true,
        "clientId": "thumble-gemini-cli",
        "authorizationUrl": "https://thumble.io/api/auth/oauth2/authorize",
        "tokenUrl": "https://thumble.io/api/auth/oauth2/token",
        "issuer": "https://thumble.io/api/auth",
        "scopes": [
          "offline_access",
          "profiles:read",
          "devices:read",
          "deliveries:read"
        ],
        "redirectUri": "http://localhost:7777/oauth/callback",
        "audiences": [
          "https://thumble.io/mcp"
        ]
      }
    }
  }
}

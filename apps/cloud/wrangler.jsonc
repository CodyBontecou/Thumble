{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "vars": { "AI_CONTROLLER_GENERATOR_ENABLED": "false" },
  "name": "thumble-cloud",
  "main": "src/worker.js",
  "assets": { "directory": "../../assets/public", "binding": "ASSETS", "run_worker_first": true, "html_handling": "none", "not_found_handling": "none" },
  "ratelimits": [{ "name": "REST_RATE_LIMITER", "namespace_id": "1763832001", "simple": { "limit": 600, "period": 60 } }],
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "d1_databases": [{ "binding": "DB", "database_name": "thumble-cloud", "database_id": "REPLACE_WITH_D1_DATABASE_ID", "migrations_dir": "migrations" }]
}

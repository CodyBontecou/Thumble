{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "thumble-cloud-pilot",
  "account_id": "e4265f322e6380ee832b83ad45e3e8c0",
  "main": "src/worker.js",
  "assets": { "directory": "../../assets/public", "binding": "ASSETS", "run_worker_first": true, "html_handling": "none", "not_found_handling": "none" },
  "ratelimits": [{ "name": "REST_RATE_LIMITER", "namespace_id": "1763832001", "simple": { "limit": 600, "period": 60 } }],
  "compatibility_date": "2026-10-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "triggers": { "crons": ["* * * * *"] },
  "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["signin@auth.thumble.io"] }],
  "routes": [
    { "pattern": "thumble.io/api/auth*", "zone_name": "thumble.io" },
    { "pattern": "thumble.io/sign-in*", "zone_name": "thumble.io" },
    { "pattern": "thumble.io/consent*", "zone_name": "thumble.io" },
    { "pattern": "thumble.io/account*", "zone_name": "thumble.io" },
    { "pattern": "thumble.io/v1/*", "zone_name": "thumble.io" },
    { "pattern": "thumble.io/.well-known/oauth-authorization-server*", "zone_name": "thumble.io" },
    { "pattern": "thumble.io/.well-known/openid-configuration*", "zone_name": "thumble.io" },
    { "pattern": "thumble.io/assets/thumble/*", "zone_name": "thumble.io" },
    { "pattern": "thumble.io/mcp", "zone_name": "thumble.io" },
    { "pattern": "thumble.io/.well-known/oauth-protected-resource*", "zone_name": "thumble.io" },
    { "pattern": "thumble.io/.well-known/openai-apps-challenge", "zone_name": "thumble.io" }
  ],
  "vars": {
    "GLAMA_MONITOR_EMAIL": "codybontecou+thumble-glama@gmail.com",
    "AI_CONTROLLER_GENERATOR_ENABLED": "false",
    "EMAIL_FROM": "signin@auth.thumble.io",
    "BETTER_AUTH_URL": "https://thumble.io",
    "LEGACY_AUTH_URL": "https://thumble-cloud-pilot.costream.workers.dev",
    "ACCOUNT_ID_ISSUER": "https://thumble-cloud-pilot.costream.workers.dev/api/auth",
    "MCP_RESOURCE_URL": "https://thumble.io/mcp",
    "CHATGPT_REDIRECT_URIS": "[\"https://chatgpt.com/connector_platform_oauth_redirect\"]"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "thumble-cloud-pilot",
      "database_id": "67be3503-2cee-4303-a6d2-dcc396ce2e68",
      "migrations_dir": "migrations"
    }
  ]
}

{
  "name": "thumble-purchases-sandbox",
  "main": "src/worker.js",
  "account_id": "e4265f322e6380ee832b83ad45e3e8c0",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat"],
  "alias": { "node-fetch": "./src/worker-fetch.js" },
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "APPLE_ENVIRONMENT": "Sandbox",
    "APPLE_BUNDLE_ID": "com.thumble.ios",
    "APPLE_APP_ID": "6826421489"
  },
  "ratelimits": [{ "name": "PURCHASE_LIMITER", "namespace_id": "17001", "simple": { "limit": 30, "period": 60 } }],
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false } }
}

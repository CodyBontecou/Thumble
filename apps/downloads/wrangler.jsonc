{
  "name": "thumble-downloads",
  "account_id": "e4265f322e6380ee832b83ad45e3e8c0",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-23",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "thumble.io/downloads/*", "zone_name": "thumble.io" }],
  "r2_buckets": [{ "binding": "RELEASES", "bucket_name": "pocketpad-releases" }],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "logs": { "enabled": true, "invocation_logs": false }
  }
}
